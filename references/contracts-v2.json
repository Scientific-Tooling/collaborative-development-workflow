        "event_type",
        "status",
        "stop_confirmed",
        "stopped_at",
        "stop_reason"
      ],
      "fields": {
        "version": {"type": "const", "value": "runtime-stop-event-v2"},
        "event_type": {"type": "const", "value": "RUNTIME_STOP_EVENT"},
        "status": {"type": "enum_ref", "ref": "runtime_events.stop_status"},
        "stop_confirmed": {"type": "enum_ref", "ref": "runtime_events.stop_confirmed"},
        "stopped_at": {"type": "monotonic_timestamp"},
        "stop_reason": {"type": "text", "max_bytes": 1024}
      }
    },
    "runtime_event_sequence": {
      "required": ["version", "events"],
      "fields": {
        "version": {"type": "const", "value": "runtime-event-sequence-v2"},
        "events": {"type": "runtime_event_list", "max_items": 64, "min_items": 1}
      }
    },
    "context_handoff": {
      "required": [
        "version",
        "handoff_id",
        "task_id",
        "run_id",
        "parent_task_id",
        "source_task_id",
        "source_run_id",
        "mode",
        "original_request",
        "accepted_plan",
        "baseline",
        "scope",
        "acceptance_criteria",
        "focused_checks",
        "checkpoint",
        "artifacts",
        "active_work",
        "open_risks",
        "decisions"
      ],
      "fields": {
        "version": {"type": "const", "value": "context-handoff-v2"},
        "handoff_id": {"type": "token", "max_bytes": 128},
        "task_id": {"type": "identifier"},
        "run_id": {"type": "identifier"},
        "parent_task_id": {"type": "identifier_or_none"},
        "source_task_id": {"type": "identifier_or_none"},
        "source_run_id": {"type": "identifier_or_none"},
        "mode": {"type": "enum", "values": ["continuation", "independent"]},
