        "status": {"type": "enum_ref", "ref": "runtime_events.terminal_status"},
        "child_started": {"type": "enum_ref", "ref": "runtime_events.child_started"},
        "stop_confirmed": {"type": "enum_ref", "ref": "runtime_events.stop_confirmed"},
        "cancel_confirmed_at": {"type": "monotonic_timestamp_or_none"},
