        "status_digest": {"type": "identifier_or_none"}
      }
    },
    "checkpoint": {
      "required": ["checkpoint_id", "status", "completed_milestone", "changed_paths", "content_identity", "next_action"],
      "fields": {
        "checkpoint_id": {"type": "token", "max_bytes_ref": "limits.token_bytes"},
        "status": {"type": "enum_ref", "ref": "statuses.checkpoint_statuses"},
        "completed_milestone": {"type": "text", "max_bytes": 512},
        "changed_paths": {"type": "path_list", "max_items": 128, "set_like": true},
        "content_identity": {"type": "identifier_or_none"},
        "next_action": {"type": "text", "max_bytes": 512}
      }
    },
    "artifact": {
      "required": ["kind", "artifact_id", "artifact_path", "content_identity"],
      "fields": {
        "kind": {"type": "token", "max_bytes": 64},
        "artifact_id": {"type": "token", "max_bytes_ref": "limits.token_bytes"},
        "artifact_path": {"type": "text", "max_bytes": 512},
        "content_identity": {"type": "identifier_or_none"}
      }
    },
    "active_work": {
      "required": ["run_id", "task_id", "attempt", "invocation_id", "role", "state", "lock_scope", "runtime_terminal_event_id"],
