        "terminal_reason": {"type": "text", "max_bytes": 1024}
      }
    },
    "runtime_terminal_event": {
      "mixins": ["runtime_event"],
      "required": [
        "version",
        "event_type",
        "status",
        "child_started",
        "stop_confirmed",
        "cancel_confirmed_at",
        "terminal_at",
        "terminal_reason"
      ],
      "fields": {
        "version": {"type": "const", "value": "runtime-terminal-event-v2"},
