        "content_identity": {"type": "sha256"},
        "impact_scope_digest": {"type": "sha256"},
        "artifact_access_proof_digest": {"type": "sha256"},
        "reviewer_result_digest": {"type": "sha256"},
        "review_paths": {"type": "path_list", "max_items": 128, "set_like": true},
