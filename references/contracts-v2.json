        "invocation_id": {"type": "identifier_or_none"},
        "binding_token": {"type": "identifier_or_none"},
        "binding_mode": {"type": "enum", "values": ["transport_bound_provisional", "runtime_atomic"]},
        "role": {"type": "enum_ref", "ref": "statuses.roles"},
        "mode": {"type": "enum", "values": ["portable", "strict"]},
