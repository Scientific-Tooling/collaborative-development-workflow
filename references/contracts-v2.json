        "summary": {"type": "text", "max_bytes_ref": "limits.summary_bytes"}
      }
    },
    "model_profile": {
      "required": [],
      "min_properties": 1,
      "fields": {
        "model": {"type": "text", "max_bytes_ref": "limits.token_bytes"},
        "effort": {"type": "text", "max_bytes_ref": "limits.short_token_bytes"},
        "selection_outcome": {"type": "enum_ref", "ref": "statuses.model_selection_outcomes"}
      }
    },
    "role_payload": {
      "required": [],
      "min_properties": 1,
      "fields": {
