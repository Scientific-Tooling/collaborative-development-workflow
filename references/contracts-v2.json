        "plan_or_critique": {"type": "text", "max_bytes_ref": "limits.summary_bytes"},
        "material_decisions": {"type": "bounded_text_or_list", "max_items": 16, "max_bytes_ref": "limits.summary_bytes"},
        "milestones": {"type": "bounded_text_or_list", "max_items": 16, "max_bytes_ref": "limits.summary_bytes"},
        "prerequisites": {"type": "bounded_text_or_list", "max_items": 16, "max_bytes_ref": "limits.summary_bytes"},
        "write_scope": {"type": "bounded_text_or_list", "max_items": 16, "max_bytes_ref": "limits.summary_bytes"},
        "integration_order": {"type": "bounded_text_or_list", "max_items": 16, "max_bytes_ref": "limits.summary_bytes"},
        "mode": {"type": "enum", "values": ["portable", "strict"]},
        "exclusions": {"type": "bounded_text_or_list", "max_items": 16, "max_bytes_ref": "limits.summary_bytes"},
        "focused_checks": {"type": "bounded_text_or_list", "max_items": 16, "max_bytes_ref": "limits.summary_bytes"},
        "risks": {"type": "bounded_text_or_list", "max_items": 16, "max_bytes_ref": "limits.summary_bytes"},
        "research_scope": {"type": "text", "max_bytes_ref": "limits.summary_bytes"},
        "evidence": {"type": "bounded_text_or_list", "max_items": 16, "max_bytes_ref": "limits.summary_bytes"},
        "open_questions": {"type": "bounded_text_or_list", "max_items": 16, "max_bytes_ref": "limits.summary_bytes"},
        "recommendation": {"type": "text", "max_bytes_ref": "limits.summary_bytes"},
        "milestone": {"type": "text", "max_bytes_ref": "limits.summary_bytes"},
        "remaining_risks": {"type": "bounded_text_or_list", "max_items": 16, "max_bytes_ref": "limits.summary_bytes"},
