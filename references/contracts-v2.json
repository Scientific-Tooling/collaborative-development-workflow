        "acceptance_criteria": {"type": "acceptance_list", "min_items": 1, "max_items": 32},
        "focused_checks": {"type": "focused_check_list", "max_items": 32},
        "checkpoint": {"type": "checkpoint_or_none"},
        "artifacts": {"type": "artifact_list", "max_items": 32},
        "active_work": {"type": "active_work_list", "max_items": 32},
        "open_risks": {"type": "risk_list", "max_items": 16},
        "decisions": {"type": "decision_list", "max_items": 16}
      }
    }
  }
}
