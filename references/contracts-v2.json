{
  "contract": "collaborative-development-workflow",
  "version": "contract-v2",
  "canonicalization": {
    "encoding": "UTF-8",
    "json": "compact JSON with lexicographically sorted object keys, ensure_ascii=false, and no duplicate keys or non-finite numbers",
    "paths": "repository-relative POSIX paths; dot components are removed, parent traversal and absolute paths are rejected",
    "hash_algorithm": "SHA-256",
    "domains": {
      "record": "cdw-contract-v2\u0000",
      "snapshot_content": "cdw-snapshot-content-v2\u0000",
      "snapshot_manifest": "cdw-snapshot-manifest-v2\u0000",
      "snapshot_entry": "cdw-snapshot-entry-v2\u0000"
    }
  },
  "sentinels": [
    "NONE",
    "UNSET",
    "UNKNOWN",
    "NOT_RUN",
    "UNASSIGNED"
  ],
  "limits": {
    "token_bytes": 128,
    "short_token_bytes": 64,
    "text_bytes": 4096,
    "summary_bytes": 1024,
    "path_bytes": 512,
    "command_bytes": 1024,
    "scope_entries": 128,
    "covered_scope_entries": 64,
    "checks": 32,
    "findings": 64,
    "risks": 16,
    "decisions": 16,
    "plan_steps": 32,
    "artifacts": 32,
    "active_work": 32,
    "review_rounds": 3,
    "symlink_target_bytes": 4096,
    "json_bytes": 4194304,
    "json_depth": 64,
    "snapshot_depth": 64,
    "snapshot_file_bytes": 16777216,
    "snapshot_total_bytes": 67108864,
    "git_output_bytes": 16777216,
    "git_timeout_seconds": 30,
    "runtime_events": 64
  },
  "statuses": {
    "common_exceptional": [
      "NEEDS_INPUT",
      "NEEDS_USER_DECISION",
      "PARTIAL",
      "BLOCKED",
      "FAILED",
      "CANCELLED"
    ],
    "role_success": {
      "researcher": "RESEARCH_READY",
      "planner": "PLAN_READY",
      "implementer": "CHECKPOINT_READY",
      "verifier": "VERIFICATION_READY"
    },
    "review": [
      "CLEAN",
      "FINDINGS",
      "REVIEW_BLOCKED"
    ],
    "review_disposition": [
      "CLEAN",
      "FINDINGS",
      "REVIEW_UNAVAILABLE",
      "REVIEW_BLOCKED"
    ],
    "roles": [
      "researcher",
      "planner",
      "implementer",
      "reviewer",
      "verifier"
    ],
    "review_findings": [
      "OPEN",
      "ADDRESSED",
      "WONT_FIX_WITH_AUTHORIZATION"
    ],
    "check": [
      "PASSED",
      "FAILED",
      "NOT_RUN",
      "SKIPPED"
    ],
    "workflow_outcomes": [
      "ACCEPTED_PORTABLE",
      "ACCEPTED_STRICT",
      "NOT_ACCEPTED"
    ],
    "validation": [
      "PASSED",
      "FAILED",
      "NOT_RUN"
    ],
    "ledger_states": [
      "PENDING",
      "READY",
      "CLAIMED",
      "RUNNING",
      "COMPLETED",
      "VERIFIED",
      "INTEGRATION_PENDING",
      "INTEGRATED",
      "ACCEPTED",
      "NEEDS_INPUT",
      "PARTIAL",
      "BLOCKED",
      "FAILED",
      "CANCELLED",
      "QUARANTINED"
    ],
    "risk_statuses": [
      "OPEN",
      "MITIGATED",
      "ACCEPTED"
    ],
    "actionable_finding_statuses": ["OPEN"],
    "decision_statuses": ["pending", "accepted", "rejected"],
    "plan_step_statuses": ["planned", "in_progress", "done", "blocked"],
    "acceptance_statuses": ["pending", "met", "blocked"],
    "finding_severities": ["BLOCKER", "HIGH", "MEDIUM", "LOW", "INFO"],
    "checkpoint_statuses": [
      "PLAN_READY",
      "CHECKPOINT_READY",
      "VERIFICATION_READY",
      "PARTIAL",
      "INTEGRATION_PENDING",
      "INTEGRATED"
    ],
    "coverage_statuses": ["COMPLETE", "INCOMPLETE"],
    "commit_statuses": ["NOT_REQUESTED", "PENDING", "CREATED", "BLOCKED"],
    "model_selection_strategies": ["explicit", "inherit", "runtime_default"],
    "model_fallback_policies": ["fail", "allow_runtime_default"],
    "model_selection_outcomes": ["honored", "fallback", "unknown"],
    "reviewer_model_independence": ["same_allowed", "different_preferred", "different_required"],
    "not_accepted_reasons": [
      "REVIEW_UNAVAILABLE",
      "REVIEW_BLOCKED",
      "VALIDATION_FAILED",
      "IDENTITY_MISMATCH",
      "USER_DECISION_REQUIRED",
      "STRICT_CAPABILITY_MISSING",
      "SCOPE_CHANGED",
      "QUARANTINED_RESULT",
      "EVIDENCE_INVALID"
    ],
    "not_accepted_reason_rules": {
      "REVIEW_UNAVAILABLE": {
        "review_status": ["REVIEW_UNAVAILABLE"]
      },
      "REVIEW_BLOCKED": {
        "review_status": ["REVIEW_BLOCKED"]
      },
      "VALIDATION_FAILED": {
        "validation_status": ["FAILED"]
      },
      "IDENTITY_MISMATCH": {
        "review_status": ["REVIEW_BLOCKED", "REVIEW_UNAVAILABLE"]
      },
      "USER_DECISION_REQUIRED": {},
      "STRICT_CAPABILITY_MISSING": {
        "mode": ["strict"],
        "review_status": ["REVIEW_BLOCKED", "REVIEW_UNAVAILABLE"]
      },
      "SCOPE_CHANGED": {
        "review_status": ["REVIEW_BLOCKED", "REVIEW_UNAVAILABLE"]
      },
      "QUARANTINED_RESULT": {
        "review_status": ["REVIEW_BLOCKED", "REVIEW_UNAVAILABLE"]
      },
      "EVIDENCE_INVALID": {}
    }
  },
  "runtime_events": {
    "record_kinds": {
      "RUNTIME_COMPLETION_EVENT": "runtime_completion_event",
      "RUNTIME_TERMINAL_EVENT": "runtime_terminal_event",
      "RUNTIME_STOP_EVENT": "runtime_stop_event"
    },
    "clock_sources": ["monotonic"],
    "completion_status": ["completed"],
    "terminal_status": ["failed", "cancelled", "errored", "shutdown", "spawn_failed"],
    "stop_status": ["stopped"],
    "child_started": ["yes", "no"],
    "stop_confirmed": ["yes", "not_applicable"]
  },
  "modes": {
    "values": [
      "portable",
      "strict"
    ],
    "required_capabilities": {
      "portable": [
        "read_only_subagent_identity",
        "terminal_result_delivery",
        "shared_snapshot_access"
      ],
      "strict_additional": [
        "atomic_spawn_binding",
        "cas_state",
        "verified_monotonic_timing",
        "runtime_lifecycle_events",
        "exact_stop_targets",
        "immutable_artifact_proofs",
        "authoritative_runtime_adapter"
      ]
    }
  },
  "artifact_contracts": {
    "snapshot_manifest": {
      "version": "snapshot-manifest-v2",
      "fields": [
        "version",
        "base_git_identity",
        "scope_paths",
        "scope_digest",
        "entries",
        "baseline_entries",
        "content_identity",
        "manifest_identity"
      ],
      "git_identity_fields": [
        "head",
        "branch",
        "index_tree",
        "worktree_status_digest"
      ],
      "entry": {
        "fields": [
          "path",
          "status",
          "type",
          "mode",
          "size",
          "content_hash",
          "symlink_target",
          "artifact_path"
        ],
        "statuses": ["present", "deleted"],
        "types": ["file", "directory", "symlink", "deleted"],
        "artifact_prefixes": {
          "files": "files",
          "baseline": "baseline"
        }
      },
      "baseline_types": ["file", "symlink"],
      "top_level": ["manifest.json", "files", "baseline"],
      "limits": {
        "max_entries": {"limit_ref": "limits.scope_entries", "multiplier": 64},
        "snapshot_depth_ref": "limits.snapshot_depth",
        "symlink_target_bytes_ref": "limits.symlink_target_bytes",
        "manifest_bytes_ref": "limits.json_bytes",
        "file_bytes_ref": "limits.snapshot_file_bytes",
        "total_bytes_ref": "limits.snapshot_total_bytes",
        "git_output_bytes_ref": "limits.git_output_bytes"
      }
    }
  },
  "field_sets": {
    "runtime_event_identity": {
      "required": [
        "event_id",
        "run_id",
        "task_id",
        "invocation_id",
        "attempt",
        "agent_id",
        "agent_channel",
        "transport_invocation_association",
        "runtime_target",
        "binding_token",
        "clock_source"
      ],
      "fields": {
        "event_id": {"type": "identifier"},
        "run_id": {"type": "identifier_or_none"},
        "task_id": {"type": "identifier_or_none"},
        "invocation_id": {"type": "identifier_or_none"},
        "attempt": {"type": "positive_integer"},
        "agent_id": {"type": "identifier_or_none"},
        "agent_channel": {"type": "identifier_or_none"},
        "transport_invocation_association": {"type": "identifier_or_none"},
        "runtime_target": {"type": "text", "max_bytes": 512},
        "binding_token": {"type": "identifier_or_none"},
        "clock_source": {"type": "enum_ref", "ref": "runtime_events.clock_sources"}
      }
    }
  },
  "mixins": {
    "runtime_event": {
      "field_sets": ["runtime_event_identity"]
    }
  },
  "nested_records": {
    "check": {
      "required": ["id", "status", "summary"],
      "fields": {
        "id": {"type": "token", "max_bytes_ref": "limits.short_token_bytes"},
        "status": {"type": "enum_ref", "ref": "statuses.check"},
        "summary": {"type": "text", "max_bytes_ref": "limits.summary_bytes"}
      }
    },
    "risk": {
      "required": ["id", "status", "summary"],
      "fields": {
        "id": {"type": "token", "max_bytes_ref": "limits.short_token_bytes"},
        "status": {"type": "enum_ref", "ref": "statuses.risk_statuses"},
        "summary": {"type": "text", "max_bytes_ref": "limits.summary_bytes"}
      }
    },
    "finding": {
      "required": ["id", "severity", "path", "line", "summary", "evidence", "impact", "fix", "status"],
      "fields": {
        "id": {"type": "token", "max_bytes_ref": "limits.short_token_bytes"},
        "severity": {"type": "enum_ref", "ref": "statuses.finding_severities"},
        "path": {"type": "path"},
        "line": {"type": "positive_integer"},
        "summary": {"type": "text", "max_bytes_ref": "limits.summary_bytes"},
        "evidence": {"type": "text", "max_bytes_ref": "limits.summary_bytes"},
        "impact": {"type": "text", "max_bytes_ref": "limits.summary_bytes"},
        "fix": {"type": "text", "max_bytes_ref": "limits.summary_bytes"},
        "status": {"type": "enum_ref", "ref": "statuses.review_findings"}
      }
    },
    "plan_step": {
      "required": ["step_id", "status", "summary"],
      "fields": {
        "step_id": {"type": "token", "max_bytes_ref": "limits.short_token_bytes"},
        "status": {"type": "enum_ref", "ref": "statuses.plan_step_statuses"},
        "summary": {"type": "text", "max_bytes_ref": "limits.summary_bytes"}
      }
    },
    "acceptance_criterion": {
      "required": ["criterion_id", "status", "summary"],
      "fields": {
        "criterion_id": {"type": "token", "max_bytes_ref": "limits.short_token_bytes"},
        "status": {"type": "enum_ref", "ref": "statuses.acceptance_statuses"},
        "summary": {"type": "text", "max_bytes_ref": "limits.summary_bytes"}
      }
    },
    "baseline": {
      "required": ["branch", "head", "status_digest"],
      "fields": {
