        "read_scope": {"type": "path_list", "max_items": 128, "set_like": true},
        "write_scope": {"type": "path_list", "max_items": 128, "set_like": true},
        "impact_scope": {"type": "record", "kind": "impact_scope"},
        "base_snapshot": {"type": "identifier_or_none"},
        "base_content_identity": {"type": "identifier_or_none"},
        "focused_checks": {"type": "focused_check_list", "max_items": 32},
        "execution": {"type": "text", "max_bytes": 1024},
        "isolation": {"type": "text", "max_bytes": 1024},
        "budget": {"type": "record", "kind": "execution_budget"},
        "resumable": {"type": "boolean"},
        "model_request": {"type": "record", "kind": "model_request"},
        "model_profile": {"type": "model_profile"},
        "full_suite_owner": {"type": "const", "value": "main"},
        "snapshot_id": {"type": "sha256_or_none"},
        "content_identity": {"type": "sha256_or_none"},
        "artifact_path": {"type": "text_or_none", "max_bytes": 512},
        "artifact_access_proof": {"type": "identifier_or_none"},
        "review_coverage_proof": {"type": "identifier_or_none"}
      }
    },
    "impact_scope": {
      "required": [
        "version",
        "changed_paths",
        "review_paths",
        "direct_callers",
        "direct_consumers",
        "mapped_tests_or_configuration",
        "explicit_exclusions"
      ],
      "fields": {
        "version": {"type": "const", "value": "impact-scope-v2"},
        "changed_paths": {"type": "path_list", "max_items": 128, "set_like": true},
        "review_paths": {"type": "path_list", "max_items": 128, "set_like": true},
        "direct_callers": {"type": "reference_list", "max_items": 128, "set_like": true},
        "direct_consumers": {"type": "reference_list", "max_items": 128, "set_like": true},
        "mapped_tests_or_configuration": {"type": "reference_list", "max_items": 128, "set_like": true},
        "explicit_exclusions": {"type": "reference_list", "max_items": 128, "set_like": true}
      }
    },
    "focused_check": {
      "required": ["version", "id", "command_or_assertion", "covered_scope", "required"],
      "fields": {
        "version": {"type": "const", "value": "focused-check-v2"},
        "id": {"type": "token", "max_bytes": 128},
        "command_or_assertion": {"type": "text", "max_bytes": 1024},
        "covered_scope": {"type": "reference_list", "max_items": 64, "set_like": true},
        "required": {"type": "boolean"}
      }
    },
    "capability_preflight": {
      "required": ["version", "mode", "result", "capabilities", "missing", "authority"],
      "fields": {
        "version": {"type": "const", "value": "capability-preflight-v2"},
        "mode": {"type": "enum", "values": ["portable", "strict"]},
        "result": {"type": "enum", "values": ["PORTABLE_READY", "STRICT_READY", "NOT_READY"]},
        "capabilities": {"type": "capability_map"},
        "missing": {"type": "token_list", "max_items": 16, "set_like": true},
        "authority": {"type": "enum", "values": ["observed_tool_surface", "authoritative_runtime_record"]}
      }
    },
    "role_result": {
      "required": [
        "version",
        "role",
        "status",
        "summary",
        "completed_scope",
        "changed_paths",
        "checks",
        "risks",
        "blocker_or_input",
        "attention_required",
        "next_action"
      ],
      "fields": {
        "version": {"type": "const", "value": "role-result-v2"},
        "role": {"type": "enum_ref", "ref": "statuses.roles"},
        "mode": {"type": "enum", "values": ["portable", "strict"]},
        "status": {"type": "role_status"},
        "summary": {"type": "text", "max_bytes": 1024},
        "completed_scope": {"type": "reference_list", "max_items": 128, "set_like": true},
        "changed_paths": {"type": "path_list", "max_items": 128, "set_like": true},
        "checks": {"type": "check_list", "max_items": 32},
        "risks": {"type": "risk_list", "max_items": 16},
        "blocker_or_input": {"type": "text_or_none", "max_bytes": 1024},
        "attention_required": {"type": "text_list", "max_items": 16, "max_bytes": 1024},
        "next_action": {"type": "text_or_none", "max_bytes": 1024},
        "role_payload": {"type": "role_payload"},
        "run_id": {"type": "identifier"},
        "task_id": {"type": "identifier"},
        "attempt": {"type": "positive_integer"},
        "invocation_id": {"type": "identifier"},
        "report_id": {"type": "identifier"},
        "runtime_completion_event_id": {"type": "identifier_or_none"},
        "runtime_terminal_event_id": {"type": "identifier_or_none"},
        "agent_id": {"type": "identifier_or_none"},
        "agent_channel": {"type": "identifier_or_none"},
        "transport_invocation_association": {"type": "identifier_or_none"},
        "base_snapshot": {"type": "identifier_or_none"},
        "base_content_identity": {"type": "identifier_or_none"},
        "snapshot_id": {"type": "sha256_or_none"},
        "content_identity": {"type": "sha256_or_none"},
        "artifact_access_proof": {"type": "identifier_or_none"},
        "review_coverage_proof": {"type": "identifier_or_none"},
        "reviewed_paths": {"type": "path_list", "max_items": 128, "set_like": true},
        "findings": {"type": "finding_list", "max_items": 64},
        "model_profile": {"type": "model_profile"}
      }
    },
    "workflow_outcome": {
      "required": [
        "version",
        "mode",
        "outcome",
        "accepted",
        "review_status",
        "reason",
        "validation_status",
        "capability_preflight_digest",
        "final_review_round_digest",
        "validation_checks",
        "full_validation_check_id",
        "commit_requested",
        "commit_status",
        "commit_blocker",
        "snapshot_id",
        "content_identity",
        "commit_id"
      ],
      "fields": {
        "version": {"type": "const", "value": "workflow-outcome-v2"},
        "mode": {"type": "enum", "values": ["portable", "strict"]},
        "outcome": {"type": "enum_ref", "ref": "statuses.workflow_outcomes"},
        "accepted": {"type": "boolean"},
        "review_status": {"type": "enum_ref", "ref": "statuses.review_disposition"},
        "reason": {"type": "enum_ref_or_none", "ref": "statuses.not_accepted_reasons"},
        "validation_status": {"type": "enum_ref", "ref": "statuses.validation"},
        "capability_preflight_digest": {"type": "sha256_or_none"},
        "final_review_round_digest": {"type": "sha256_or_none"},
        "validation_checks": {"type": "check_list", "max_items": 32},
        "full_validation_check_id": {"type": "identifier_or_none"},
        "commit_requested": {"type": "boolean"},
        "commit_status": {"type": "enum_ref", "ref": "statuses.commit_statuses"},
        "commit_blocker": {"type": "text_or_none", "max_bytes": 1024},
        "snapshot_id": {"type": "sha256_or_none"},
        "content_identity": {"type": "sha256_or_none"},
        "commit_id": {"type": "identifier_or_none"}
      }
    },
    "runtime_completion_event": {
      "mixins": ["runtime_event"],
      "required": [
        "version",
        "event_type",
        "status",
        "result_delivery_confirmed",
        "terminal_at",
        "terminal_reason"
